    <comp lib="7" loc="(1000,990)" name="Text">
      <a name="text" val="Control_Unit (la FSM)"/>
    </comp>
    <comp lib="7" loc="(1015,1690)" name="Text">
      <a name="text" val="Datapath (ruta de datos)"/>
    </comp>
    <comp lib="7" loc="(1040,1515)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PC_EN = PCWRITE OR (BRANCH AND (ZERO XOR BNE))."/>
    </comp>
    <comp lib="7" loc="(1100,1715)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Contiene PC, IR, A, B, ALUOut, el banco de registros y la unica ALU."/>
    </comp>
    <comp lib="7" loc="(1105,1015)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS y ALUOP_DEC vienen del decodificador, V0_IS_10/11 del Datapath."/>
    </comp>
    <comp lib="7" loc="(1115,1030)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Sus salidas gobiernan el Datapath; PCWRITE y BRANCH van a Branch_Control."/>
    </comp>
    <comp lib="7" loc="(1125,715)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Entra OP y FUNCT (salen del IR en el Datapath). Dice el tipo de instruccion."/>
    </comp>
    <comp lib="7" loc="(1145,45)" name="Text">
      <a name="color" val="#125400"/>
      <a name="font" val="SansSerif plain 16"/>
      <a name="text" val="Alvaro Vladimir Besada Ferrer C211"/>
    </comp>
    <comp lib="7" loc="(230,720)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Datapath -&gt; Instruction_Decoder:  OP, FUNCT."/>
    </comp>
    <comp lib="7" loc="(230,775)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Instruction_Decoder -&gt; Branch_Control:  BNE."/>
    </comp>
    <comp lib="7" loc="(245,830)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="                           REGDST, WDSEL, SYSSEL."/>
    </comp>
    <comp lib="7" loc="(265,705)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Control_Unit -&gt; pines de la CPU:  MEM_WE, TTY_WE, HALT."/>
    </comp>
    <comp lib="7" loc="(270,760)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Instruction_Decoder -&gt; Datapath:  EXTZERO, BYTE, UNSIGNED."/>
    </comp>
    <comp lib="7" loc="(300,685)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Datapath -&gt; pines de la CPU:  MEM_ADDR, MEM_WDATA, MEM_BE, TTY_DATA."/>
    </comp>
    <comp lib="7" loc="(315,900)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="origen cada uno; ninguna senal tiene dos drivers (comprobado por script)."/>
    </comp>
    <comp lib="7" loc="(320,740)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Instruction_Decoder -&gt; Control_Unit:  CLASS, ALUOP (llega como ALUOP_DEC)."/>
    </comp>
    <comp lib="7" loc="(355,795)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Datapath -&gt; Control_Unit:  V0_IS_10, V0_IS_11.     Datapath -&gt; Branch_Control:  ZERO."/>
    </comp>
    <comp lib="7" loc="(355,810)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Control_Unit -&gt; Datapath:  IRWRITE, ADDRSEL, PCSRC, ALUSRCA, ALUSRCB, ALUOP, REGWRITE,"/>
    </comp>
    <comp lib="7" loc="(355,885)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Los 17 pines de entrada del Datapath y los 6 de la Control_Unit tienen exactamente un"/>
    </comp>
    <comp lib="7" loc="(365,850)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Control_Unit -&gt; Branch_Control:  PCWRITE, BRANCH.     Branch_Control -&gt; Datapath:  PC_EN."/>
    </comp>
    <comp lib="7" loc="(370,640)" name="Text">
      <a name="text" val="CONEXIONES (todas por tunel: mismo nombre = mismo cable)"/>
    </comp>
    <comp lib="7" loc="(385,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Pines de la CPU -&gt; subcircuitos:  CLK, RESET -&gt; Datapath y Control_Unit;  MEM_RDATA -&gt; Datapath."/>
    </comp>
    <comp lib="7" loc="(500,40)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="CPU S-MIPS multiciclo: cableado de los 4 subcircuitos"/>
    </comp>
    <comp lib="7" loc="(500,65)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="No cambiar nombres, anchos ni sentido de los pines: la placa depende de ellos."/>
    </comp>
    <comp lib="7" loc="(965,1490)" name="Text">
      <a name="text" val="Branch_Control"/>
    </comp>
    <comp lib="7" loc="(990,690)" name="Text">
      <a name="text" val="Instruction_Decoder"/>
    </comp>
