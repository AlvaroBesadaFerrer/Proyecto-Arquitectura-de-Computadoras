    </comp>
    <comp lib="0" loc="(940,1110)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="A"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(940,260)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(940,360)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(940,380)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NB"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(980,1690)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="OP"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="0" loc="(980,420)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="SUB"/>
      <a name="labelfont" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" loc="(980,490)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="SUB"/>
      <a name="labelfont" val="SansSerif plain 12"/>
    </comp>
    <comp lib="1" loc="(1000,260)" name="NOT Gate">
      <a name="width" val="32"/>
    </comp>
    <comp lib="1" loc="(1000,660)" name="AND Gate">
      <a name="width" val="32"/>
    </comp>
    <comp lib="1" loc="(1000,780)" name="OR Gate">
      <a name="width" val="32"/>
    </comp>
    <comp lib="2" loc="(1000,1620)" name="Multiplexer">
      <a name="select" val="3"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="2" loc="(1000,370)" name="Multiplexer">
      <a name="width" val="32"/>
    </comp>
    <comp lib="3" loc="(1000,1230)" name="Shifter">
      <a name="width" val="32"/>
    </comp>
    <comp lib="3" loc="(1000,1350)" name="Shifter">
      <a name="shift" val="lr"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="3" loc="(1000,150)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="3" loc="(1000,1790)" name="Comparator">
      <a name="width" val="32"/>
    </comp>
    <comp lib="3" loc="(1000,540)" name="Adder">
      <a name="width" val="32"/>
    </comp>
    <comp lib="3" loc="(1000,900)" name="Comparator">
      <a name="width" val="32"/>
    </comp>
    <comp lib="7" loc="(110,1375)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="se ignoran."/>
    </comp>
    <comp lib="7" loc="(110,1530)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="indefinido."/>
    </comp>
    <comp lib="7" loc="(120,1420)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="SENAL ZERO"/>
    </comp>
    <comp lib="7" loc="(1300,1000)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SLTR = 31 ceros y LT en el bit 0"/>
    </comp>
    <comp lib="7" loc="(1300,1110)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SHAMT = A[4:0]: cantidad de bits a desplazar"/>
    </comp>
    <comp lib="7" loc="(1300,1230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SLLR = B desplazado a la izquierda SHAMT bits (rellena con 0)"/>
    </comp>
    <comp lib="7" loc="(1300,1350)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SRLR = B desplazado a la derecha SHAMT bits (logico, rellena con 0)"/>
    </comp>
    <comp lib="7" loc="(1300,1460)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ZERO32: valor del codigo sin usar (OP = 111)"/>
    </comp>
    <comp lib="7" loc="(1300,150)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SUB = 1 cuando OP = 001 (resta)"/>
    </comp>
    <comp lib="7" loc="(1300,1620)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="RES = operacion elegida por OP (ver tabla)"/>
    </comp>
    <comp lib="7" loc="(1300,1790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Z = 1 cuando RES = 0  (salida ZERO)"/>
    </comp>
    <comp lib="7" loc="(1300,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="NB = B negado bit a bit"/>
    </comp>
    <comp lib="7" loc="(1300,370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BB = B (suma) o NB (resta)"/>
    </comp>
    <comp lib="7" loc="(1300,540)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="Unico sumador: SUM = A + BB + SUB  (A - B = A + ~B + 1)"/>
    </comp>
    <comp lib="7" loc="(1300,660)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ANDR = A AND B"/>
    </comp>
    <comp lib="7" loc="(1300,780)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ORR = A OR B"/>
    </comp>
    <comp lib="7" loc="(1300,900)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Comparador CON SIGNO: LT = 1 si A &lt; B"/>
    </comp>
    <comp lib="7" loc="(1330,800)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada bit del resultado es el OR de los bits de A y B. Solo sale si OP = 011."/>
    </comp>
    <comp lib="7" loc="(1350,920)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="LT = 1 si A &lt; B. Va CON SIGNO: asi -1 (0xFFFFFFFF) es menor que 1, como exige slt."/>
    </comp>
    <comp lib="7" loc="(1370,1250)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada posicion a la izquierda multiplica por 2. Entra B como dato y SHAMT como distancia."/>
    </comp>
    <comp lib="7" loc="(1375,1480)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Es la entrada 7 del multiplexor final: evita que RESULT quede indefinido con un OP sin uso."/>
    </comp>
    <comp lib="7" loc="(1380,1130)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Un divisor de bits (splitter) separa los 5 bits bajos de A: la cantidad a desplazar (0 a 31)."/>
    </comp>
    <comp lib="7" loc="(1380,1810)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Compara RES con la constante 0. Su salida de igualdad es ZERO, que la CPU usara en beq y bne."/>
    </comp>
    <comp lib="7" loc="(1380,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Su acarreo de entrada es SUB. El acarreo de salida se descarta: el resultado es modulo 2^32."/>
    </comp>
    <comp lib="7" loc="(1385,280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="NB es B con todos los bits invertidos: es la mitad del truco para restar (A - B = A + NB + 1)."/>
    </comp>
    <comp lib="7" loc="(1390,1020)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RESULT tiene 32 bits y LT solo 1: se rellena con 31 ceros a la izquierda. El resultado es 0 o 1."/>
    </comp>
    <comp lib="7" loc="(1390,1370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada posicion a la derecha divide por 2 sin signo: rellena con ceros, no copia el bit de signo."/>
    </comp>
    <comp lib="7" loc="(1390,1640)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="El selector OP (000..111) elige la entrada 0..7: SUM, SUM, ANDR, ORR, SLTR, SLLR, SRLR, ZERO32."/>
    </comp>
    <comp lib="7" loc="(1390,170)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Compara OP con 001: si es resta, SUB = 1. Esa senal elige NB y pone a 1 el acarreo del sumador."/>
    </comp>
    <comp lib="7" loc="(1390,390)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Con SUB = 0 pasa B (suma). Con SUB = 1 pasa NB (resta). Asi un solo sumador sirve para las dos."/>
    </comp>
    <comp lib="7" loc="(1395,680)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada bit del resultado es el AND de los bits de A y B. Se calcula siempre; solo sale si OP = 010."/>
    </comp>
    <comp lib="7" loc="(145,1485)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="CODIGO OP = 111"/>
    </comp>
    <comp lib="7" loc="(165,960)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="COMO FUNCIONA LA ALU"/>
    </comp>
    <comp lib="7" loc="(180,1070)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="POR QUE UN SOLO SUMADOR"/>
    </comp>
    <comp lib="7" loc="(195,1310)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="DESPLAZAMIENTOS (SLL y SRL)"/>
    </comp>
    <comp lib="7" loc="(220,1110)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="restar es A + (B negado) + 1 (complemento a dos)."/>
    </comp>
    <comp lib="7" loc="(230,1220)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="POR QUE EL COMPARADOR VA CON SIGNO"/>
    </comp>
    <comp lib="7" loc="(255,1180)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Ejemplo: 5 - 7 = 5 + 0xFFFFFFF8 + 1 = 0xFFFFFFFE, que es -2."/>
    </comp>
    <comp lib="7" loc="(265,1135)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ADD: el multiplexor deja pasar B y el acarreo de entrada vale 0."/>
    </comp>
    <comp lib="7" loc="(285,1245)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="slt compara numeros con signo: 0xFFFFFFFF vale -1, que es menor que 1."/>
    </comp>
    <comp lib="7" loc="(295,1025)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Al final, un multiplexor de 8 entradas elige segun OP cual resultado sale."/>
    </comp>
    <comp lib="7" loc="(295,1155)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SUB: deja pasar NB (B negado) y el acarreo de entrada vale 1 (senal SUB)."/>
    </comp>
    <comp lib="7" loc="(295,345)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="A: primer operando (32 bits)"/>
    </comp>
    <comp lib="7" loc="(295,980)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="La ALU es combinacional: no guarda nada. RESULT depende solo de A, B y OP."/>
    </comp>
    <comp lib="7" loc="(300,1265)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Un comparador sin signo diria lo contrario; por eso va en complemento a dos."/>
    </comp>
    <comp lib="7" loc="(300,1510)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Ninguna instruccion lo usa; sale una constante 0 para que RESULT nunca quede"/>
    </comp>
    <comp lib="7" loc="(300,445)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="B: segundo operando (32 bits)"/>
    </comp>
    <comp lib="7" loc="(305,1090)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="La guia pide una unica ALU y ningun otro sumador. Suma y resta comparten uno:"/>
    </comp>
    <comp lib="7" loc="(305,1355)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="con ceros. La CPU pondra en A el shamt de la instruccion. Los bits altos de A"/>
    </comp>
    <comp lib="7" loc="(305,525)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="OP: elige la operacion (3 bits)"/>
    </comp>
    <comp lib="7" loc="(310,1330)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Mueven los bits de B tantas posiciones como diga A[4:0] (de 0 a 31) y rellenan"/>
    </comp>
    <comp lib="7" loc="(310,1440)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Compara RESULT con 0. Para beq/bne la CPU resta los dos registros y mira ZERO."/>
    </comp>
    <comp lib="7" loc="(315,1000)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Calcula TODAS las operaciones a la vez, cada una en su bloque (columna derecha)."/>
    </comp>
    <comp lib="7" loc="(350,600)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Codificacion de OP"/>
    </comp>
    <comp lib="7" loc="(350,635)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="000  ADD   A + B"/>
    </comp>
    <comp lib="7" loc="(350,660)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="001  SUB   A - B"/>
    </comp>
    <comp lib="7" loc="(350,685)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="010  AND   A AND B"/>
    </comp>
    <comp lib="7" loc="(350,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="011  OR    A OR B"/>
    </comp>
    <comp lib="7" loc="(350,735)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="100  SLT   1 si A &lt; B (con signo), si no 0"/>
    </comp>
    <comp lib="7" loc="(350,760)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="101  SLL   B &lt;&lt; A[4:0]"/>
    </comp>
    <comp lib="7" loc="(350,785)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="110  SRL   B &gt;&gt; A[4:0] (logico)"/>
    </comp>
    <comp lib="7" loc="(350,810)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="111  sin uso (resultado 0)"/>
    </comp>
    <comp lib="7" loc="(350,860)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="En SLL/SRL el operando A trae la cantidad a desplazar (solo se usan sus 5 bits bajos)"/>
    </comp>
    <comp lib="7" loc="(350,885)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="y B trae el valor a desplazar."/>
    </comp>
    <comp lib="7" loc="(475,490)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ZERO: 1 si RESULT vale 0"/>
    </comp>
    <comp lib="7" loc="(485,400)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RESULT: resultado de 32 bits"/>
    </comp>
    <comp lib="7" loc="(700,60)" name="Text">
      <a name="text" val="ALU: una sola ALU combinacional de 32 bits"/>
    </comp>
    <comp lib="7" loc="(700,90)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Entradas A, B (32 bits) y OP (3 bits). Salidas RESULT (32 bits) y ZERO (1 si RESULT = 0)."/>
    </comp>
    <wire from="(1000,1000)" to="(1030,1000)"/>
    <wire from="(1000,1230)" to="(1030,1230)"/>
