    <comp lib="5" loc="(1580,1700)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="A"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="5" loc="(1580,1860)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="B"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="5" loc="(2260,1670)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="ALUOut"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="5" loc="(960,1110)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="IR"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="5" loc="(960,850)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="PC"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="7" loc="(1015,520)" name="Text">
      <a name="text" val="1) PC - contador de programa"/>
    </comp>
    <comp lib="7" loc="(1030,1030)" name="Text">
      <a name="text" val="2) IR - registro de instruccion"/>
    </comp>
    <comp lib="7" loc="(1060,2040)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PC[31:28]: los 4 bits altos del PC, para el destino de j/jal"/>
    </comp>
    <comp lib="7" loc="(1060,2195)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="El PC ya vale PC+4 (se incremento en FETCH), como pide MIPS."/>
    </comp>
    <comp lib="7" loc="(1060,580)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="El PC solo se escribe si PC_EN=1 (PCWRITE, o branch tomado)."/>
    </comp>
    <comp lib="7" loc="(1065,1325)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ADDRSEL=0 -&gt; PC (fetch); ADDRSEL=1 -&gt; ALUOut (lw/lb/lbu/sw/sb)."/>
    </comp>
    <comp lib="7" loc="(1090,1545)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="op=IR[31:26] rs=[25:21] rt=[20:16] rd=[15:11] shamt=[10:6] funct=[5:0]"/>
    </comp>
    <comp lib="7" loc="(1090,2170)" name="Text">
      <a name="text" val="5) Destino de j/jal = {PC[31:28], addr, 00}"/>
    </comp>
    <comp lib="7" loc="(1095,545)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PCSRC elige el proximo PC: 0=resultado directo de la ALU (PC+4 en FETCH),"/>
    </comp>
    <comp lib="7" loc="(1110,1055)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Guarda la instruccion durante todos sus ciclos; se carga en FETCH (IRWRITE=1)."/>
    </comp>
    <comp lib="7" loc="(1115,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="1=ALUOut (destino de branch calculado en DECODE), 2=destino de j/jal, 3=A (jr)."/>
    </comp>
    <comp lib="7" loc="(1135,1520)" name="Text">
      <a name="text" val="4) Campos de la instruccion (solo cables, sin logica)"/>
    </comp>
    <comp lib="7" loc="(1555,1630)" name="Text">
      <a name="text" val="8) Registros A y B"/>
    </comp>
    <comp lib="7" loc="(1590,540)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="si no, se leen rs y rt de la instruccion."/>
    </comp>
    <comp lib="7" loc="(1595,2070)" name="Text">
      <a name="text" val="9) Comparadores de syscall"/>
    </comp>
    <comp lib="7" loc="(1625,1105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="2=PC (direccion de retorno de jal), 3=sin uso (cero)."/>
    </comp>
    <comp lib="7" loc="(1630,2095)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="A guarda $v0: V0_IS_10 = (A==10) y V0_IS_11 = (A==11)."/>
    </comp>
    <comp lib="7" loc="(1635,500)" name="Text">
      <a name="text" val="6) Entradas del banco de registros"/>
    </comp>
    <comp lib="7" loc="(1650,525)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYSSEL=1 fuerza leer $v0 (reg 2) y $a0 (reg 4) para syscall;"/>
    </comp>
    <comp lib="7" loc="(1670,1655)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Guardan rs y rt leidos. Se cargan en TODOS los flancos (EN=1 fijo)."/>
    </comp>
    <comp lib="7" loc="(1685,1090)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Dato a escribir (WDSEL): 0=ALUOut, 1=dato de memoria alineado/extendido,"/>
    </comp>
    <comp lib="7" loc="(1685,2110)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Son comparadores, no sumadores: la unica ALU es el subcircuito ALU (R14)."/>
    </comp>
    <comp lib="7" loc="(1695,870)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Registro destino (REGDST): 0=rt (tipo I, load), 1=rd (tipo R), 2=$31 (jal)."/>
    </comp>
    <comp lib="7" loc="(1700,1375)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Escribe en el flanco de subida si REGWRITE=1. Lee RD1 y RD2 sin esperar reloj."/>
    </comp>
    <comp lib="7" loc="(1710,1350)" name="Text">
      <a name="text" val="7) Banco de registros (subcircuito Register_File)"/>
    </comp>
    <comp lib="7" loc="(2190,1580)" name="Text">
      <a name="text" val="13) Registro ALUOut"/>
    </comp>
    <comp lib="7" loc="(220,1520)" name="Text">
      <a name="text" val="CONSTANTES (nombres K...)"/>
    </comp>
    <comp lib="7" loc="(2220,1310)" name="Text">
      <a name="text" val="12) ALU (subcircuito ALU)"/>
    </comp>
    <comp lib="7" loc="(2225,565)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="0=PC, 1=A, 2=shamt (sll/srl), 3=cero (lui)."/>
    </comp>
    <comp lib="7" loc="(2265,1620)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="el PC y el banco lo leen un ciclo despues de calcularlo."/>
    </comp>
    <comp lib="7" loc="(2265,540)" name="Text">
      <a name="text" val="10) Operando A de la ALU (ALUSRCA)"/>
    </comp>
    <comp lib="7" loc="(2265,890)" name="Text">
      <a name="text" val="11) Operando B de la ALU (ALUSRCB)"/>
    </comp>
    <comp lib="7" loc="(2300,1335)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP: 000 add, 001 sub, 010 and, 011 or, 100 slt, 101 sll, 110 srl."/>
    </comp>
    <comp lib="7" loc="(2315,1605)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Guarda el resultado de la ALU. Se carga en TODOS los flancos (EN=1 fijo);"/>
    </comp>
    <comp lib="7" loc="(2330,915)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="0=B, 1=constante 4, 2=inmediato (con signo; con ceros si EXTZERO=1: andi/ori),"/>
    </comp>
    <comp lib="7" loc="(2340,1350)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="En sll/srl toma el shamt de ALUA y el valor de ALUB. ZERO=1 si el resultado es 0."/>
    </comp>
    <comp lib="7" loc="(2370,930)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="3=inmediato con signo &lt;&lt;2 (destino de branch), 4={imm,16 ceros} (lui), 5..7 sin uso (cero)."/>
    </comp>
    <comp lib="7" loc="(245,205)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXTZERO, BYTE y UNSIGNED del Instruction_Decoder."/>
    </comp>
    <comp lib="7" loc="(270,185)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IRWRITE..SYSSEL de Control_Unit; PC_EN de Branch_Control;"/>
    </comp>
    <comp lib="7" loc="(2885,1110)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SignExt(imm)&lt;&lt;2 sin desplazador ni sumador."/>
    </comp>
    <comp lib="7" loc="(2895,1400)" name="Text">
      <a name="text" val="16) {imm, 16 ceros} para lui"/>
    </comp>
    <comp lib="7" loc="(2905,1070)" name="Text">
      <a name="text" val="15) imm con signo &lt;&lt;2 (branch)"/>
    </comp>
    <comp lib="7" loc="(2930,1095)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Se extiende a 30 bits y se anaden 2 ceros por la derecha:"/>
    </comp>
    <comp lib="7" loc="(2955,590)" name="Text">
      <a name="text" val="14) Extension del inmediato imm=IR[15:0]"/>
    </comp>
    <comp lib="7" loc="(300,120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Las redes se unen por nombre con tunel (mismo nombre = mismo cable)."/>
    </comp>
    <comp lib="7" loc="(3015,615)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IMMEXT = EXTZERO ? ceros : signo. EXTZERO=1 solo en andi/ori (lo da el decodificador)."/>
    </comp>
    <comp lib="7" loc="(315,170)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ENTRADAS (pines a la izquierda): CLK, RESET y MEM_RDATA vienen de la CPU;"/>
    </comp>
    <comp lib="7" loc="(340,85)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Una sola ALU, un solo banco de registros y la unica memoria esta fuera (Memory)."/>
    </comp>
    <comp lib="7" loc="(3420,1570)" name="Text">
      <a name="text" val="18) Escritura (sw/sb)"/>
    </comp>
    <comp lib="7" loc="(3420,2320)" name="Text">
      <a name="text" val="19) TTY_DATA = B[6:0]"/>
    </comp>
    <comp lib="7" loc="(3430,500)" name="Text">
      <a name="text" val="17) Lectura (lw/lb/lbu)"/>
    </comp>
    <comp lib="7" loc="(3530,1375)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE=1 (lb/lbu): dato = byte extendido; BYTE=0 (lw): palabra completa."/>
    </comp>
    <comp lib="7" loc="(3530,525)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_RDATA se parte en 4 bytes (little-endian: byte k = bits 8k+7..8k);"/>
    </comp>
    <comp lib="7" loc="(3535,2345)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Es el caracter de $a0, que SYSSEL=1 dejo cargado en B durante el syscall."/>
    </comp>
    <comp lib="7" loc="(355,245)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SALIDAS (pines a la derecha): MEM_ADDR, MEM_WDATA y MEM_BE van a la Memory; OP y FUNCT"/>
    </comp>
    <comp lib="7" loc="(3560,1595)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="sw: MEM_WDATA=B y MEM_BE=1111. sb: el byte B[7:0] se replica en los 4 carriles y"/>
    </comp>
    <comp lib="7" loc="(3575,540)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOut[1:0] elige el byte y se extiende con signo (lb) o con ceros (lbu, UNSIGNED=1)."/>
    </comp>
    <comp lib="7" loc="(3585,1610)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_BE activa solo el carril ALUOut[1:0] (decodificador). MEM_WE lo pone la Control_Unit."/>
    </comp>
    <comp lib="7" loc="(385,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Todos los registros (PC, IR, A, B, ALUOut y los del banco) llevan CLK directo (R3) y CLR=RESET."/>
    </comp>
    <comp lib="7" loc="(385,50)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="DATAPATH - ruta de datos del S-MIPS multiciclo"/>
    </comp>
    <comp lib="7" loc="(390,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="al Instruction_Decoder; ZERO a Branch_Control; V0_IS_10/V0_IS_11 a Control_Unit; TTY_DATA al TTY."/>
    </comp>
    <comp lib="7" loc="(950,1800)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="imm = IR[15:0] (16 bits)"/>
    </comp>
    <comp lib="7" loc="(990,1300)" name="Text">
      <a name="text" val="3) Direccion de memoria"/>
    </comp>
    <comp lib="7" loc="(990,1920)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="addr = IR[25:0] (26 bits, para j/jal)"/>
    </comp>
    <comp loc="(1920,1430)" name="Register_File"/>
