    <comp lib="7" loc="(714,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 1: dividir en digitos octales"/>
    </comp>
    <comp lib="7" loc="(720,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="op = [OPH][OPL] y funct = [FNH][FNL], 3 bits cada uno."/>
    </comp>
    <comp lib="7" loc="(760,125)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Los codigos de la tabla son legibles en octal: 0x23 = 43, 0x2A = 52."/>
    </comp>
    <comp lib="7" loc="(1450,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 2: decodificadores de 3 bits"/>
    </comp>
    <comp lib="7" loc="(1354,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada uno activa UNA de 8 lineas segun el digito que recibe:"/>
    </comp>
    <comp lib="7" loc="(1408,125)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="OH4 = el digito alto de op vale 4, FL5 = el digito bajo de funct vale 5, etc."/>
    </comp>
    <comp lib="7" loc="(1258,420)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="OH: digito alto de op"/>
    </comp>
    <comp lib="7" loc="(1258,640)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="OL: digito bajo de op"/>
    </comp>
    <comp lib="7" loc="(1268,860)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="FH: digito alto de funct"/>
    </comp>
    <comp lib="7" loc="(1268,1080)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="FL: digito bajo de funct"/>
    </comp>
    <comp lib="7" loc="(2250,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 3: una linea por instruccion"/>
    </comp>
    <comp lib="7" loc="(2248,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="op-only: AND(digito alto, digito bajo).  Tipo R: AND(is_R, FH, FL), solo si op = 00."/>
    </comp>
    <comp lib="7" loc="(2204,125)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="R11: solo se mira op y, si op = 00, funct. rs, rt y shamt se ignoran."/>
    </comp>
    <comp lib="7" loc="(2482,264)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="op = 00 (tipo R)"/>
    </comp>
    <comp lib="7" loc="(2470,354)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="j      op 02"/>
    </comp>
    <comp lib="7" loc="(2470,444)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="jal    op 03"/>
    </comp>
    <comp lib="7" loc="(2470,534)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="beq    op 04"/>
    </comp>
    <comp lib="7" loc="(2470,624)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="bne    op 05"/>
    </comp>
    <comp lib="7" loc="(2470,714)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="addi   op 08"/>
    </comp>
    <comp lib="7" loc="(2470,804)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="addiu  op 09"/>
    </comp>
    <comp lib="7" loc="(2470,894)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="slti   op 0A"/>
    </comp>
    <comp lib="7" loc="(2470,984)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="andi   op 0C"/>
    </comp>
    <comp lib="7" loc="(2470,1074)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ori    op 0D"/>
    </comp>
    <comp lib="7" loc="(2470,1164)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="lui    op 0F"/>
    </comp>
    <comp lib="7" loc="(2470,1254)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="lb     op 20"/>
    </comp>
    <comp lib="7" loc="(2470,1344)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="lw     op 23"/>
    </comp>
    <comp lib="7" loc="(2470,1434)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="lbu    op 24"/>
    </comp>
    <comp lib="7" loc="(2470,1524)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="sb     op 28"/>
    </comp>
    <comp lib="7" loc="(2470,1614)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="sw     op 2B"/>
    </comp>
    <comp lib="7" loc="(2496,1704)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="add    op 00 funct 20"/>
    </comp>
    <comp lib="7" loc="(2496,1794)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="addu   op 00 funct 21"/>
    </comp>
    <comp lib="7" loc="(2496,1884)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="sub    op 00 funct 22"/>
    </comp>
    <comp lib="7" loc="(2496,1974)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="and    op 00 funct 24"/>
    </comp>
    <comp lib="7" loc="(2496,2064)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="or     op 00 funct 25"/>
    </comp>
    <comp lib="7" loc="(2496,2154)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="slt    op 00 funct 2A"/>
    </comp>
    <comp lib="7" loc="(2538,2244)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="sll    op 00 funct 00 (incluye nop)"/>
    </comp>
    <comp lib="7" loc="(2496,2334)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="srl    op 00 funct 02"/>
    </comp>
    <comp lib="7" loc="(2496,2424)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="jr     op 00 funct 08"/>
    </comp>
    <comp lib="7" loc="(2500,2514)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="syscall op 00 funct 0C"/>
    </comp>
    <comp lib="7" loc="(3810,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 4: clases y salidas"/>
    </comp>
    <comp lib="7" loc="(3528,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Primero una linea por clase (OR de sus instrucciones). ILL = ninguna clase legal activa (NOR)."/>
    </comp>
    <comp lib="7" loc="(3506,125)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Luego cada bit de CLASS y ALUOP es un OR de las clases/instrucciones que lo tienen a 1."/>
    </comp>
    <comp lib="7" loc="(3686,264)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 0: aritmetica tipo R"/>
    </comp>
    <comp lib="7" loc="(3680,374)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 1: desplazamientos"/>
    </comp>
    <comp lib="7" loc="(3708,464)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 2: aritmetica con inmediato"/>
    </comp>
    <comp lib="7" loc="(3654,554)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 4: cargas"/>
    </comp>
    <comp lib="7" loc="(3680,644)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 5: almacenamientos"/>
    </comp>
    <comp lib="7" loc="(3696,734)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 6: saltos condicionales"/>
    </comp>
    <comp lib="7" loc="(3740,824)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 15: ILEGAL (ninguna instruccion legal)"/>
    </comp>
    <comp lib="7" loc="(3696,974)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[0]: clases 1,3,5,7,9,15"/>
    </comp>
    <comp lib="7" loc="(3698,1084)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[1]: clases 2,3,6,7,10,15"/>
    </comp>
    <comp lib="7" loc="(3690,1194)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[2]: clases 4,5,6,7,15"/>
    </comp>
    <comp lib="7" loc="(3686,1284)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[3]: clases 8,9,10,15"/>
    </comp>
    <comp lib="7" loc="(3730,1374)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP[0]: SUB, OR, SLL (y beq/bne restan)"/>
    </comp>
    <comp lib="7" loc="(3674,1484)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP[1]: AND, OR, SRL"/>
    </comp>
    <comp lib="7" loc="(3678,1574)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP[2]: SLT, SLL, SRL"/>
    </comp>
    <comp lib="7" loc="(3726,1664)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXTZERO: andi y ori extienden con ceros"/>
    </comp>
    <comp lib="7" loc="(3680,1754)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE: accesos de un byte"/>
    </comp>
    <comp lib="7" loc="(4628,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 5: empaquetar los buses"/>
    </comp>
    <comp lib="7" loc="(4674,380)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS = {CL3,CL2,CL1,CL0}"/>
    </comp>
    <comp lib="7" loc="(4662,610)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP = {AO2,AO1,AO0}"/>
    </comp>
    <comp lib="7" loc="(184,440)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="INSTRUCTION_DECODER"/>
    </comp>
    <comp lib="7" loc="(322,462)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Circuito combinacional, sin estado. Entradas: OP (6 bits) y FUNCT (6 bits)."/>
    </comp>
    <comp lib="7" loc="(280,484)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="No usa ROM ni RAM: solo divisores, decodificadores y puertas."/>
    </comp>
    <comp lib="7" loc="(130,528)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="SALIDAS"/>
    </comp>
    <comp lib="7" loc="(334,550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS (4 bits): que tipo de instruccion es. Es lo que usa la unidad de control."/>
    </comp>
    <comp lib="7" loc="(282,572)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   0 R_ALU  1 SHIFT  2 I_ALU  3 LUI  4 LOAD  5 STORE  6 BRANCH"/>
    </comp>
    <comp lib="7" loc="(242,594)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   7 J  8 JAL  9 JR  10 SYSCALL  15 ILEGAL (R10)"/>
    </comp>
    <comp lib="7" loc="(328,616)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP (3 bits): 000 ADD, 001 SUB, 010 AND, 011 OR, 100 SLT, 101 SLL, 110 SRL."/>
    </comp>
    <comp lib="7" loc="(316,638)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   Los branch dan SUB; cargas, stores, lui, j y jal dan ADD (no importa)."/>
    </comp>
    <comp lib="7" loc="(310,660)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXTZERO: 1 en andi y ori (inmediato con ceros); en el resto, con signo."/>
    </comp>
    <comp lib="7" loc="(312,682)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BNE: 1 solo en bne.   BYTE: 1 en lb, lbu, sb.   UNSIGNED: 1 solo en lbu."/>
    </comp>
    <comp lib="7" loc="(162,726)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="POR QUE ES ASI"/>
    </comp>
    <comp lib="7" loc="(336,748)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada instruccion se reconoce con una unica linea is_xxx (etapa 3). Todo lo demas"/>
    </comp>
    <comp lib="7" loc="(322,770)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="son ORs de esas lineas, asi que cambiar una instruccion solo toca un sitio."/>
    </comp>
    <comp lib="7" loc="(348,792)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ILEGAL = NOR de todas las clases legales: no hace falta enumerar los casos ilegales."/>
    </comp>
    <comp lib="7" loc="(336,814)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="0x00000000 es sll $zero,$zero,0 (nop): op = 00 y funct = 00, por tanto es LEGAL."/>
    </comp>
    <comp lib="7" loc="(330,836)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="addu (funct 21) y addiu (op 09) son legales (R9): MARS los usa para move y li."/>
    </comp>
