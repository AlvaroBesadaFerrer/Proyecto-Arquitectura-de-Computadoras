    <comp lib="7" loc="(300,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLK: reloj (se escribe al subir)"/>
    </comp>
    <comp lib="7" loc="(308,145)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RESET: 1 = vuelve al estado inicial"/>
    </comp>
    <comp lib="7" loc="(294,185)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="WE: 1 = permite escribir ahora"/>
    </comp>
    <comp lib="7" loc="(306,225)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RA1: registro a leer (0-31) en RD1"/>
    </comp>
    <comp lib="7" loc="(306,265)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RA2: registro a leer (0-31) en RD2"/>
    </comp>
    <comp lib="7" loc="(312,305)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="WA: registro donde se escribe (0-31)"/>
    </comp>
    <comp lib="7" loc="(306,345)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="WD: dato de 32 bits que se escribe"/>
    </comp>
    <comp lib="7" loc="(188,470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Recibe el numero WA y activa"/>
    </comp>
    <comp lib="7" loc="(182,490)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SOLO la salida EN_n de ese"/>
    </comp>
    <comp lib="7" loc="(184,510)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="registro, y solo si WE = 1."/>
    </comp>
    <comp lib="7" loc="(172,530)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada EN_n habilita a un"/>
    </comp>
    <comp lib="7" loc="(184,550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="registro. La salida EN_0 no"/>
    </comp>
    <comp lib="7" loc="(176,570)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="se conecta: asi $0 no se"/>
    </comp>
    <comp lib="7" loc="(166,590)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="puede escribir nunca."/>
    </comp>
    <comp lib="7" loc="(500,1004)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ESCRIBIR $gp: guarda WD XOR 0x1800"/>
    </comp>
    <comp lib="7" loc="(500,1104)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ESCRIBIR $sp: guarda WD XOR 0x3FFC"/>
    </comp>
    <comp lib="7" loc="(504,1204)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="LEER $gp: valor guardado XOR 0x1800"/>
    </comp>
    <comp lib="7" loc="(504,1304)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="LEER $sp: valor guardado XOR 0x3FFC"/>
    </comp>
    <comp lib="7" loc="(500,1404)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="$zero: constante 0, siempre vale 0"/>
    </comp>
    <comp lib="7" loc="(2514,395)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Elige UNA de las 32 entradas R_n"/>
    </comp>
    <comp lib="7" loc="(2502,415)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="segun RA1 y la copia en RD1."/>
    </comp>
    <comp lib="7" loc="(2512,435)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Es combinacional: no usa reloj."/>
    </comp>
    <comp lib="7" loc="(2514,895)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Elige UNA de las 32 entradas R_n"/>
    </comp>
    <comp lib="7" loc="(2502,915)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="segun RA2 y la copia en RD2."/>
    </comp>
    <comp lib="7" loc="(2512,935)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Es combinacional: no usa reloj."/>
    </comp>
    <comp lib="7" loc="(1200,1510)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="COMO LEER ESTE CIRCUITO (de izquierda a derecha)"/>
    </comp>
    <comp lib="7" loc="(1200,1534)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="1. ENTRADAS: cada pin de la izquierda va a un tunel con su mismo nombre; asi las senales llegan a donde hacen falta sin cruzar cables."/>
    </comp>
    <comp lib="7" loc="(1200,1558)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="2. ESCRITURA: WA (5 bits) y WE entran al decodificador, que activa la linea EN_n del registro elegido. Los otros 30 registros no reciben habilitacion y conservan su valor."/>
    </comp>
    <comp lib="7" loc="(1200,1582)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="3. REGISTROS: cada R1..R31 es un registro de 32 bits. Su entrada D recibe WD, su reloj es CLK y su borrado es RESET. Guarda WD solo en el flanco de subida de CLK y solo si su EN vale 1."/>
    </comp>
    <comp lib="7" loc="(1200,1606)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="4. LECTURA: dos multiplexores de 32 entradas eligen el registro n segun RA1 y RA2. Son combinacionales: RD1 y RD2 cambian en cuanto cambian RA1 y RA2, sin esperar al reloj."/>
    </comp>
    <comp lib="7" loc="(1200,1630)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   Por eso una instruccion puede leer dos registros y, en el mismo ciclo, escribir un tercero: la lectura es inmediata y la escritura ocurre al final, en el flanco."/>
    </comp>
    <comp lib="7" loc="(1200,1654)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="5. $zero: la entrada 0 de los multiplexores es una constante 0, y la salida 0 del decodificador no se conecta. El registro 0 siempre vale 0 y no se puede escribir."/>
    </comp>
    <comp lib="7" loc="(1200,1678)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="6. RESET: pone todos los registros a 0 al instante (borrado asincrono, no espera al reloj). Mientras RESET = 1 no se puede escribir."/>
    </comp>
    <comp lib="7" loc="(1200,1702)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="7. $gp y $sp: tras el reset deben valer 0x1800 y 0x3FFC, pero el componente registro solo se borra a 0. Por eso estos dos guardan el valor combinado con XOR con su valor inicial K."/>
    </comp>
    <comp lib="7" loc="(1200,1726)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   Escribir: se guarda WD XOR K. Leer: se calcula (valor guardado) XOR K. Como X XOR K XOR K = X, desde fuera se comporta como un registro normal, y tras RESET se lee 0 XOR K = K."/>
    </comp>
    <comp lib="7" loc="(1200,1750)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="8. POR QUE ASI: usar registros (no RAM) cumple la guia, y conectar todos directamente a CLK evita relojes derivados. El decodificador con WE evita escribir dos registros a la vez."/>
    </comp>
  </circuit>
