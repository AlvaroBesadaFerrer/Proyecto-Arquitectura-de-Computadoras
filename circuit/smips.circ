    </comp>
    <comp lib="7" loc="(1300,1790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Z = 1 cuando RES = 0  (salida ZERO)"/>
    </comp>
    <comp lib="7" loc="(700,60)" name="Text">
      <a name="font" val="SansSerif bold 16"/>
      <a name="text" val="ALU: una sola ALU combinacional de 32 bits"/>
    </comp>
    <comp lib="7" loc="(700,90)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Entradas A, B (32 bits) y OP (3 bits). Salidas RESULT (32 bits) y ZERO (1 si RESULT = 0)."/>
    </comp>
    <comp lib="7" loc="(350,600)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Codificacion de OP"/>
    </comp>
    <comp lib="7" loc="(350,635)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="000  ADD   A + B"/>
    </comp>
    <comp lib="7" loc="(350,660)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="001  SUB   A - B"/>
    </comp>
    <comp lib="7" loc="(350,685)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="010  AND   A AND B"/>
    </comp>
    <comp lib="7" loc="(350,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="011  OR    A OR B"/>
    </comp>
    <comp lib="7" loc="(350,735)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="100  SLT   1 si A &lt; B (con signo), si no 0"/>
    </comp>
    <comp lib="7" loc="(350,760)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="101  SLL   B &lt;&lt; A[4:0]"/>
    </comp>
    <comp lib="7" loc="(350,785)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="110  SRL   B &gt;&gt; A[4:0] (logico)"/>
    </comp>
    <comp lib="7" loc="(350,810)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="111  sin uso (resultado 0)"/>
    </comp>
    <comp lib="7" loc="(350,860)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="En SLL/SRL el operando A trae la cantidad a desplazar (solo se usan sus 5 bits bajos)"/>
    </comp>
    <comp lib="7" loc="(350,885)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="y B trae el valor a desplazar."/>
    </comp>
