    <comp lib="7" loc="(298,345)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="A: primer operando (32 bits)"/>
    </comp>
    <comp lib="7" loc="(300,445)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="B: segundo operando (32 bits)"/>
    </comp>
    <comp lib="7" loc="(306,525)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="OP: elige la operacion (3 bits)"/>
    </comp>
    <comp lib="7" loc="(488,402)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RESULT: resultado de 32 bits"/>
    </comp>
    <comp lib="7" loc="(476,492)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ZERO: 1 si RESULT vale 0"/>
    </comp>
    <comp lib="7" loc="(1390,174)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Compara OP con 001: si es resta, SUB = 1. Esa senal elige NB y pone a 1 el acarreo del sumador."/>
    </comp>
    <comp lib="7" loc="(1388,284)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="NB es B con todos los bits invertidos: es la mitad del truco para restar (A - B = A + NB + 1)."/>
    </comp>
    <comp lib="7" loc="(1390,394)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Con SUB = 0 pasa B (suma). Con SUB = 1 pasa NB (resta). Asi un solo sumador sirve para las dos."/>
    </comp>
    <comp lib="7" loc="(1382,564)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Su acarreo de entrada es SUB. El acarreo de salida se descarta: el resultado es modulo 2^32."/>
    </comp>
    <comp lib="7" loc="(1396,684)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada bit del resultado es el AND de los bits de A y B. Se calcula siempre; solo sale si OP = 010."/>
    </comp>
    <comp lib="7" loc="(1334,804)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada bit del resultado es el OR de los bits de A y B. Solo sale si OP = 011."/>
    </comp>
    <comp lib="7" loc="(1352,924)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="LT = 1 si A &lt; B. Va CON SIGNO: asi -1 (0xFFFFFFFF) es menor que 1, como exige slt."/>
    </comp>
    <comp lib="7" loc="(1394,1024)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RESULT tiene 32 bits y LT solo 1: se rellena con 31 ceros a la izquierda. El resultado es 0 o 1."/>
    </comp>
    <comp lib="7" loc="(1384,1134)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Un divisor de bits (splitter) separa los 5 bits bajos de A: la cantidad a desplazar (0 a 31)."/>
    </comp>
    <comp lib="7" loc="(1370,1254)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada posicion a la izquierda multiplica por 2. Entra B como dato y SHAMT como distancia."/>
    </comp>
    <comp lib="7" loc="(1390,1374)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada posicion a la derecha divide por 2 sin signo: rellena con ceros, no copia el bit de signo."/>
    </comp>
    <comp lib="7" loc="(1378,1484)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Es la entrada 7 del multiplexor final: evita que RESULT quede indefinido con un OP sin uso."/>
    </comp>
    <comp lib="7" loc="(1390,1644)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="El selector OP (000..111) elige la entrada 0..7: SUM, SUM, ANDR, ORR, SLTR, SLLR, SRLR, ZERO32."/>
    </comp>
    <comp lib="7" loc="(1384,1814)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Compara RES con la constante 0. Su salida de igualdad es ZERO, que la CPU usara en beq y bne."/>
    </comp>
    <comp lib="7" loc="(168,960)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="COMO FUNCIONA LA ALU"/>
    </comp>
    <comp lib="7" loc="(298,982)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="La ALU es combinacional: no guarda nada. RESULT depende solo de A, B y OP."/>
    </comp>
    <comp lib="7" loc="(316,1004)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Calcula TODAS las operaciones a la vez, cada una en su bloque (columna derecha)."/>
    </comp>
    <comp lib="7" loc="(298,1026)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Al final, un multiplexor de 8 entradas elige segun OP cual resultado sale."/>
    </comp>
    <comp lib="7" loc="(182,1070)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="POR QUE UN SOLO SUMADOR"/>
    </comp>
    <comp lib="7" loc="(308,1092)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="La guia pide una unica ALU y ningun otro sumador. Suma y resta comparten uno:"/>
    </comp>
    <comp lib="7" loc="(224,1114)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="restar es A + (B negado) + 1 (complemento a dos)."/>
    </comp>
    <comp lib="7" loc="(268,1136)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ADD: el multiplexor deja pasar B y el acarreo de entrada vale 0."/>
    </comp>
    <comp lib="7" loc="(296,1158)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SUB: deja pasar NB (B negado) y el acarreo de entrada vale 1 (senal SUB)."/>
    </comp>
    <comp lib="7" loc="(256,1180)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Ejemplo: 5 - 7 = 5 + 0xFFFFFFF8 + 1 = 0xFFFFFFFE, que es -2."/>
    </comp>
    <comp lib="7" loc="(230,1224)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="POR QUE EL COMPARADOR VA CON SIGNO"/>
    </comp>
    <comp lib="7" loc="(286,1246)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="slt compara numeros con signo: 0xFFFFFFFF vale -1, que es menor que 1."/>
    </comp>
    <comp lib="7" loc="(304,1268)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Un comparador sin signo diria lo contrario; por eso va en complemento a dos."/>
    </comp>
    <comp lib="7" loc="(198,1312)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="DESPLAZAMIENTOS (SLL y SRL)"/>
    </comp>
    <comp lib="7" loc="(310,1334)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Mueven los bits de B tantas posiciones como diga A[4:0] (de 0 a 31) y rellenan"/>
    </comp>
    <comp lib="7" loc="(308,1356)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="con ceros. La CPU pondra en A el shamt de la instruccion. Los bits altos de A"/>
    </comp>
    <comp lib="7" loc="(112,1378)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="se ignoran."/>
    </comp>
    <comp lib="7" loc="(124,1422)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="SENAL ZERO"/>
    </comp>
    <comp lib="7" loc="(310,1444)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Compara RESULT con 0. Para beq/bne la CPU resta los dos registros y mira ZERO."/>
    </comp>
    <comp lib="7" loc="(146,1488)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="CODIGO OP = 111"/>
    </comp>
    <comp lib="7" loc="(304,1510)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Ninguna instruccion lo usa; sale una constante 0 para que RESULT nunca quede"/>
    </comp>
    <comp lib="7" loc="(112,1532)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="indefinido."/>
    </comp>
  </circuit>
</project>
