    <comp lib="7" loc="(560,70)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="$zero (R_0) = constante 0 y no se escribe nunca. RESET=1 pone los registros a 0 (asincrono)."/>
