    </comp>
    <comp lib="1" loc="(3860,2200)" name="Buffer"/>
    <comp lib="1" loc="(3860,2290)" name="Buffer"/>
    <comp lib="1" loc="(3860,2380)" name="Buffer"/>
    <comp lib="1" loc="(3860,470)" name="Buffer"/>
    <comp lib="1" loc="(3860,560)" name="Buffer"/>
    <comp lib="1" loc="(3860,650)" name="OR Gate"/>
    <comp lib="1" loc="(3860,770)" name="OR Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(3870,1040)" name="OR Gate"/>
    <comp lib="1" loc="(3870,1160)" name="OR Gate"/>
    <comp lib="1" loc="(3870,1280)" name="OR Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(3870,1400)" name="Buffer"/>
    <comp lib="1" loc="(3870,1490)" name="OR Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(3870,1610)" name="OR Gate">
      <a name="inputs" val="4"/>
    </comp>
    <comp lib="1" loc="(3870,240)" name="OR Gate"/>
    <comp lib="1" loc="(3870,360)" name="OR Gate">
      <a name="inputs" val="4"/>
    </comp>
    <comp lib="1" loc="(3870,880)" name="OR Gate">
      <a name="inputs" val="5"/>
    </comp>
    <comp lib="2" loc="(1590,1030)" name="Decoder">
      <a name="enable" val="false"/>
      <a name="select" val="4"/>
    </comp>
    <comp lib="2" loc="(3880,2590)" name="Multiplexer">
      <a name="width" val="3"/>
    </comp>
    <comp lib="2" loc="(980,1400)" name="Decoder">
      <a name="enable" val="false"/>
      <a name="select" val="5"/>
    </comp>
    <comp lib="5" loc="(1000,330)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="STATE"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="width" val="5"/>
    </comp>
    <comp lib="7" loc="(1000,855)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Una linea S_xxx vale 1 solo en el estado actual."/>
    </comp>
    <comp lib="7" loc="(1005,575)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Un codigo no usado (19..31) tambien vuelve a FETCH."/>
    </comp>
    <comp lib="7" loc="(1020,215)" name="Text">
      <a name="text" val="1) Registro de estado STATE (5 bits)"/>
    </comp>
    <comp lib="7" loc="(1095,275)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="RESET borra el registro a 0 = FETCH (R6). Se carga en todos los flancos (EN=1 fijo)."/>
    </comp>
    <comp lib="7" loc="(1110,255)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="10 STORE, 11 BRANCH, 12 JUMP, 13 JAL, 14 JR, 15 SYS_READ, 16 SYS_DISP, 17 PRINT, 18 HALT."/>
    </comp>
    <comp lib="7" loc="(1120,560)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Se arma con 5 bits NB0..NB4 (seccion 5). Si ninguna transicion se activa, NEXT=0 (FETCH)."/>
    </comp>
    <comp lib="7" loc="(1160,240)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Codigos: 0 FETCH, 1 DECODE, 2 EXEC_R, 3 WB_R, 4 EXEC_SH, 5 EXEC_I, 6 EXEC_LUI, 7 WB_I, 8 MEM_ADDR, 9 LOAD,"/>
    </comp>
    <comp lib="7" loc="(145,830)" name="Text">
      <a name="text" val="CONSTANTES"/>
    </comp>
    <comp lib="7" loc="(1640,610)" name="Text">
      <a name="text" val="3) Decodificador de CLASS"/>
    </comp>
    <comp lib="7" loc="(1665,635)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CL0..CL10 son las clases del Instruction_Decoder:"/>
    </comp>
    <comp lib="7" loc="(1720,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLS_ILL = clase 11..15 (15 = ilegal; 11..14 no se generan) -&gt; HALT."/>
    </comp>
    <comp lib="7" loc="(1760,650)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="0 R_ALU 1 SHIFT 2 I_ALU 3 LUI 4 LOAD 5 STORE 6 BRANCH 7 J 8 JAL 9 JR 10 SYSCALL."/>
    </comp>
    <comp lib="7" loc="(2110,870)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Instrucciones ilegales"/>
    </comp>
    <comp lib="7" loc="(220,745)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SALIDAS (derecha): van al Datapath, salvo"/>
    </comp>
    <comp lib="7" loc="(2400,320)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Las demas se conectan directo (seccion 5)."/>
    </comp>
    <comp lib="7" loc="(245,725)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="V0_IS_10 / V0_IS_11 vienen del Datapath (A==$v0)."/>
    </comp>
    <comp lib="7" loc="(2460,305)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Solo las transiciones que dependen de una condicion llevan AND."/>
    </comp>
    <comp lib="7" loc="(2500,280)" name="Text">
      <a name="text" val="4) Lineas de transicion (estado AND condicion)"/>
    </comp>
    <comp lib="7" loc="(2700,1020)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + JR -&gt; JR"/>
    </comp>
    <comp lib="7" loc="(2700,880)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + J -&gt; JUMP"/>
    </comp>
    <comp lib="7" loc="(2705,950)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + JAL -&gt; JAL"/>
    </comp>
    <comp lib="7" loc="(2715,1160)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + ilegal -&gt; HALT"/>
    </comp>
    <comp lib="7" loc="(2715,1230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_ADDR + LOAD -&gt; LOAD"/>
    </comp>
    <comp lib="7" loc="(2720,390)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + R_ALU -&gt; EXEC_R"/>
    </comp>
    <comp lib="7" loc="(2720,530)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + I_ALU -&gt; EXEC_I"/>
    </comp>
    <comp lib="7" loc="(2720,600)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + LUI -&gt; EXEC_LUI"/>
    </comp>
    <comp lib="7" loc="(2725,1300)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_ADDR + STORE -&gt; STORE"/>
    </comp>
    <comp lib="7" loc="(2725,1370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_DISP + $v0=10 -&gt; HALT"/>
    </comp>
    <comp lib="7" loc="(2725,1440)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_DISP + $v0=11 -&gt; PRINT"/>
    </comp>
    <comp lib="7" loc="(2725,460)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + SHIFT -&gt; EXEC_SH"/>
    </comp>
    <comp lib="7" loc="(2725,670)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + LOAD -&gt; MEM_ADDR"/>
    </comp>
    <comp lib="7" loc="(2725,740)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + STORE -&gt; MEM_ADDR"/>
    </comp>
    <comp lib="7" loc="(2725,810)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + BRANCH -&gt; BRANCH"/>
    </comp>
    <comp lib="7" loc="(2730,1090)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="DECODE + SYSCALL -&gt; SYS_READ"/>
    </comp>
    <comp lib="7" loc="(275,710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ENTRADAS: CLASS y ALUOP_DEC vienen del Instruction_Decoder;"/>
    </comp>
    <comp lib="7" loc="(310,760)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PCWRITE y BRANCH (a Branch_Control) y MEM_WE, TTY_WE, HALT (a la CPU)."/>
    </comp>
    <comp lib="7" loc="(3165,225)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Destinos: DECODE=1 EXEC_R=2 WB_R=3 EXEC_SH=4 EXEC_I=5 EXEC_LUI=6 WB_I=7 MEM_ADDR=8 LOAD=9 STORE=10"/>
    </comp>
    <comp lib="7" loc="(3185,190)" name="Text">
      <a name="text" val="5) Proximo estado: NBk = OR de las transiciones cuyo estado destino tiene el bit k a 1"/>
    </comp>
    <comp lib="7" loc="(3185,240)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BRANCH=11 JUMP=12 JAL=13 JR=14 SYS_READ=15 SYS_DISP=16 PRINT=17 HALT=18. Todo lo demas vuelve a FETCH=0."/>
    </comp>
    <comp lib="7" loc="(3410,1160)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="bit 2 del proximo estado"/>
    </comp>
    <comp lib="7" loc="(3410,1470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="bit 3 del proximo estado"/>
    </comp>
    <comp lib="7" loc="(3420,1700)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="bit 4 del proximo estado"/>
    </comp>
    <comp lib="7" loc="(3420,430)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="bit 0 del proximo estado"/>
    </comp>
    <comp lib="7" loc="(3430,800)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="bit 1 del proximo estado"/>
    </comp>
    <comp lib="7" loc="(3750,2730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Union de bits sueltos en buses de salida:"/>
    </comp>
    <comp lib="7" loc="(3765,145)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada salida es el OR de los estados donde vale 1."/>
    </comp>
    <comp lib="7" loc="(3850,120)" name="Text">
      <a name="text" val="6) Salidas de control (tabla de control, Moore)"/>
    </comp>
    <comp lib="7" loc="(3870,2485)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="en los demas estados se reenvia ALUOP_DEC (la operacion que pide la instruccion)."/>
    </comp>
    <comp lib="7" loc="(3895,160)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Multibit: PCSRC, ALUSRCA, ALUSRCB, REGDST y WDSEL se arman con splitter a partir de sus bits."/>
    </comp>
    <comp lib="7" loc="(3900,2470)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP: en FETCH, DECODE y MEM_ADDR la ALU debe sumar (PC+4, destino de branch, direccion);"/>
    </comp>
    <comp lib="7" loc="(4040,1980)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="WDSEL[1] = JAL"/>
    </comp>
    <comp lib="7" loc="(4045,1800)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="REGDST[1] = JAL"/>
    </comp>
    <comp lib="7" loc="(4045,460)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IRWRITE = FETCH"/>
    </comp>
    <comp lib="7" loc="(4055,2190)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_WE = STORE (R5)"/>
    </comp>
    <comp lib="7" loc="(4075,230)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ADDRSEL = LOAD | STORE"/>
    </comp>
    <comp lib="7" loc="(4075,760)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PCSRC[1] = JUMP | JAL | JR"/>
    </comp>
    <comp lib="7" loc="(4105,350)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PCWRITE = FETCH | JUMP | JAL | JR"/>
    </comp>
    <comp lib="7" loc="(4115,1600)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="REGWRITE = WB_R | WB_I | LOAD | JAL"/>
    </comp>
    <comp lib="7" loc="(4120,2280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="TTY_WE = PRINT (un ciclo = un flanco, R4)"/>
    </comp>
    <comp lib="7" loc="(4125,2370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="HALT = HALT (estado absorbente hasta RESET)"/>
    </comp>
    <comp lib="7" loc="(4135,1390)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUSRCB[2] = EXEC_LUI   (4={imm,16 ceros})"/>
    </comp>
    <comp lib="7" loc="(4135,1710)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="REGDST[0] = WB_R   (REGDST: 0=rt, 1=rd, 2=$31)"/>
    </comp>
    <comp lib="7" loc="(4155,1890)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="WDSEL[0] = LOAD   (WDSEL: 0=ALUOut, 1=memoria, 2=PC)"/>
    </comp>
    <comp lib="7" loc="(4160,1030)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUSRCA[1] = EXEC_SH | EXEC_LUI   (2=shamt, 3=cero)"/>
    </comp>
    <comp lib="7" loc="(4160,1150)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUSRCB[0] = FETCH | DECODE   (1=const 4, 3=imm&lt;&lt;2)"/>
    </comp>
    <comp lib="7" loc="(4165,1480)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="FORCE_ADD = FETCH | DECODE | MEM_ADDR  (la ALU suma)"/>
    </comp>
    <comp lib="7" loc="(4165,640)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PCSRC[0] = BRANCH | JR   (PCSRC: 1=ALUOut, 2=j/jal, 3=A)"/>
    </comp>
    <comp lib="7" loc="(4170,550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BRANCH = BRANCH (Branch_Control lo combina con ZERO y BNE)"/>
    </comp>
    <comp lib="7" loc="(4185,1270)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUSRCB[1] = DECODE | EXEC_I | MEM_ADDR   (2=imm extendido)"/>
    </comp>
    <comp lib="7" loc="(4185,2070)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYSSEL = SYS_READ | SYS_DISP | PRINT   (el banco lee $v0 y $a0)"/>
    </comp>
    <comp lib="7" loc="(4210,870)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUSRCA[0] = EXEC_R | EXEC_I | EXEC_LUI | MEM_ADDR | BRANCH   (1=A)"/>
    </comp>
    <comp lib="7" loc="(425,50)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="El estado vive en un registro de 5 bits (STATE) conectado directo a CLK (R3, R15). Cada estado dura un ciclo."/>
    </comp>
    <comp lib="7" loc="(465,70)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Las salidas dependen solo del estado (Moore), salvo ALUOP, que reenvia ALUOP_DEC del decodificador cuando no se fuerza ADD."/>
    </comp>
    <comp lib="7" loc="(490,20)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="CONTROL_UNIT - maquina de estados (Moore) del S-MIPS multiciclo"/>
    </comp>
    <comp lib="7" loc="(945,535)" name="Text">
      <a name="text" val="Proximo estado NEXT"/>
    </comp>
    <comp lib="7" loc="(985,830)" name="Text">
      <a name="text" val="2) Decodificador de estado"/>
    </comp>
