    </comp>
    <comp lib="7" loc="(280,570)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   0 R_ALU  1 SHIFT  2 I_ALU  3 LUI  4 LOAD  5 STORE  6 BRANCH"/>
    </comp>
    <comp lib="7" loc="(310,660)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXTZERO: 1 en andi y ori (inmediato con ceros); en el resto, con signo."/>
    </comp>
    <comp lib="7" loc="(310,680)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BNE: 1 solo en bne.   BYTE: 1 en lb, lbu, sb.   UNSIGNED: 1 solo en lbu."/>
    </comp>
    <comp lib="7" loc="(315,635)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="   Los branch dan SUB; cargas, stores, lui, j y jal dan ADD (no importa)."/>
    </comp>
    <comp lib="7" loc="(320,460)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Circuito combinacional, sin estado. Entradas: OP (6 bits) y FUNCT (6 bits)."/>
    </comp>
    <comp lib="7" loc="(320,770)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="son ORs de esas lineas, asi que cambiar una instruccion solo toca un sitio."/>
    </comp>
    <comp lib="7" loc="(325,615)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP (3 bits): 000 ADD, 001 SUB, 010 AND, 011 OR, 100 SLT, 101 SLL, 110 SRL."/>
    </comp>
    <comp lib="7" loc="(330,550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS (4 bits): que tipo de instruccion es. Es lo que usa la unidad de control."/>
    </comp>
    <comp lib="7" loc="(330,835)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="addu (funct 21) y addiu (op 09) son legales (R9): MARS los usa para move y li."/>
    </comp>
    <comp lib="7" loc="(335,745)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Cada instruccion se reconoce con una unica linea is_xxx (etapa 3). Todo lo demas"/>
    </comp>
    <comp lib="7" loc="(335,810)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="0x00000000 es sll $zero,$zero,0 (nop): op = 00 y funct = 00, por tanto es LEGAL."/>
    </comp>
    <comp lib="7" loc="(345,790)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ILEGAL = NOR de todas las clases legales: no hace falta enumerar los casos ilegales."/>
    </comp>
    <comp lib="7" loc="(3505,125)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Luego cada bit de CLASS y ALUOP es un OR de las clases/instrucciones que lo tienen a 1."/>
    </comp>
    <comp lib="7" loc="(3525,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Primero una linea por clase (OR de sus instrucciones). ILL = ninguna clase legal activa (NOR)."/>
    </comp>
    <comp lib="7" loc="(3650,550)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 4: cargas"/>
    </comp>
    <comp lib="7" loc="(3670,1480)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP[1]: AND, OR, SRL"/>
    </comp>
    <comp lib="7" loc="(3675,1570)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP[2]: SLT, SLL, SRL"/>
    </comp>
    <comp lib="7" loc="(3680,1750)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE: accesos de un byte"/>
    </comp>
    <comp lib="7" loc="(3680,370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 1: desplazamientos"/>
    </comp>
    <comp lib="7" loc="(3680,640)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 5: almacenamientos"/>
    </comp>
    <comp lib="7" loc="(3685,1280)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[3]: clases 8,9,10,15"/>
    </comp>
    <comp lib="7" loc="(3685,260)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 0: aritmetica tipo R"/>
    </comp>
    <comp lib="7" loc="(3690,1190)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[2]: clases 4,5,6,7,15"/>
    </comp>
    <comp lib="7" loc="(3695,1080)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[1]: clases 2,3,6,7,10,15"/>
    </comp>
    <comp lib="7" loc="(3695,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 6: saltos condicionales"/>
    </comp>
    <comp lib="7" loc="(3695,970)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS[0]: clases 1,3,5,7,9,15"/>
    </comp>
    <comp lib="7" loc="(3705,460)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 2: aritmetica con inmediato"/>
    </comp>
    <comp lib="7" loc="(3725,1660)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXTZERO: andi y ori extienden con ceros"/>
    </comp>
    <comp lib="7" loc="(3730,1370)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP[0]: SUB, OR, SLL (y beq/bne restan)"/>
    </comp>
    <comp lib="7" loc="(3740,820)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="clase 15: ILEGAL (ninguna instruccion legal)"/>
    </comp>
    <comp lib="7" loc="(3810,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 4: clases y salidas"/>
    </comp>
    <comp lib="7" loc="(4625,80)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 5: empaquetar los buses"/>
    </comp>
    <comp lib="7" loc="(4660,610)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALUOP = {AO2,AO1,AO0}"/>
    </comp>
    <comp lib="7" loc="(4670,380)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS = {CL3,CL2,CL1,CL0}"/>
    </comp>
    <comp lib="7" loc="(691,20)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="ETAPA 1: dividir en digitos octales"/>
    </comp>
    <comp lib="7" loc="(700,45)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="op = [OPH][OPL] y funct = [FNH][FNL], 3 bits cada uno."/>
    </comp>
    <comp lib="7" loc="(717,72)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Los codigos de la tabla son legibles en octal: 0x23 = 43, 0x2A = 52."/>
    </comp>
