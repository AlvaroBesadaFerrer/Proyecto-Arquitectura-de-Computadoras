  <circuit name="Branch_Control">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Branch_Control"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(100,170)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="BRANCH"/>
    </comp>
    <comp lib="0" loc="(100,235)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="BNE"/>
    </comp>
    <comp lib="0" loc="(100,275)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="ZERO"/>
    </comp>
    <comp lib="0" loc="(100,80)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="PCWRITE"/>
    </comp>
    <comp lib="0" loc="(500,100)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="PC_EN"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(240,255)" name="XOR Gate"/>
    <comp lib="1" loc="(360,190)" name="AND Gate"/>
    <comp lib="1" loc="(470,100)" name="OR Gate"/>
    <comp lib="7" loc="(225,340)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ZERO XOR BNE = &quot;la condicion de salto se cumple&quot;:"/>
    </comp>
    <comp lib="7" loc="(270,375)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="  bne (BNE=1): se salta si ZERO=0 (los registros son distintos)."/>
    </comp>
    <comp lib="7" loc="(290,355)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="  beq (BNE=0): se salta si ZERO=1 (A-B = 0, los registros son iguales)."/>
    </comp>
    <comp lib="7" loc="(310,410)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PCWRITE OR ... = en FETCH, JUMP, JAL y JR el PC se carga siempre (PCWRITE=1)."/>
    </comp>
    <comp lib="7" loc="(310,465)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Es solo logica combinacional: no hay ningun elemento de estado ni reloj (R3)."/>
    </comp>
    <comp lib="7" loc="(320,445)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ZERO del Datapath (salida de la ALU). Salida PC_EN: al Datapath (habilita el PC)."/>
    </comp>
    <comp lib="7" loc="(325,390)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BRANCH AND (...) = solo cuenta en el estado BRANCH; en los demas estados BRANCH=0."/>
    </comp>
    <comp lib="7" loc="(325,430)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Entradas: PCWRITE y BRANCH vienen de la Control_Unit, BNE del Instruction_Decoder,"/>
    </comp>
    <comp lib="7" loc="(330,20)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="BRANCH_CONTROL - decide si el PC se carga"/>
    </comp>
    <comp lib="7" loc="(330,50)" name="Text">
      <a name="text" val="PC_EN = PCWRITE  OR  ( BRANCH AND ( ZERO XOR BNE ) )"/>
    </comp>
    <wire from="(100,170)" to="(310,170)"/>
    <wire from="(100,235)" to="(180,235)"/>
    <wire from="(100,275)" to="(180,275)"/>
    <wire from="(100,80)" to="(420,80)"/>
    <wire from="(240,255)" to="(270,255)"/>
